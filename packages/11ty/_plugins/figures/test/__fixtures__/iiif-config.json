{
  "baseURI": "http://localhost:8080",
  "dirs": {
    "imagesDir": "_assets/images",
    "inputRoot": "/test-project/_site",
    "outputPath": "iiif",
    "outputRoot": "/test-project/_site"
  },
  "formats": [
    {
      "input": [
        ".png",
        ".svg"
      ],
      "output": ".jpg"
    },
    {
      "input": [
        ".jpg",
        ".jpeg",
        ".tif",
        ".tiff"
      ],
      "output": ".jpg"
    }
  ],
  "locale": "en",
  "manifestFileName": "manifest.json",
  "printComposites": {
    "bottomMargin": 24,
    "itemGap": 12,
    "itemTileSize": 900,
    "leftMargin": 24,
    "rightMargin": 24,
    "topMargin": 24,
    "width": 1800
  },
  "tilesDirName": "tiles",
  "tileSize": 256,
  "transformations": [
      {
        "name": "full",
        "resize": {}
      },
      {
        "name": "thumbnail",
        "resize": {
          "width": 320
        }
      },
      {
        "name": "print-image",
        "resize": {
          "width": 2025,
          "withoutEnlargement": true
        }
      },
      {
        "name": "static-inline-figure-image",
        "resize": {
          "width": 640
        }
      }
  ]
}
